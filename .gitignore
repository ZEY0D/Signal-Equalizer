# =========================
# Python Backend
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
music-eq-backend/venv/
music-eq-backend/env/
music-eq-backend/.venv/

# Python packaging
*.egg-info/
music-eq-backend/dist/
music-eq-backend/build/

# =========================
# Node / Frontend
# =========================
music-eq-frontend/node_modules/
music-eq-frontend/dist/
music-eq-frontend/dist-ssr/
music-eq-frontend/*.local
music-eq-frontend/build/

spare-eqz-frontend/node_modules/
