# =========================
# 🚨 CRITICAL: Audio Files (These are HUGE!)
# =========================
*.wav
*.mp3
*.flac
*.ogg
*.aac
*.m4a

# Uploads and outputs directories (runtime generated files)
music-eq-backend/uploads/
music-eq-backend/outputs/
music-eq-backend/configs/

# =========================
# AI Models & Checkpoints (VERY LARGE!)
# =========================
*.pt
*.pth
*.h5
*.ckpt
*.pb
*.onnx
*.bin
*.safetensors

# Model directories
music-eq-backend/models/*/checkpoints/
music-eq-backend/models/*/pretrained/
music-eq-backend/models/**/*.pt
music-eq-backend/models/**/*.pth

# Entire HumanModel/asteroid library (3rd-party, hundreds of files)
music-eq-backend/models/HumanModel/asteroid/

# =========================
# Data / Numpy files
# =========================
*.npy
*.npz
*.pkl
*.pickle

# =========================
# Spectrograms & Images
# =========================
music-eq-backend/outputs/spectrograms/
# Note: We allow *.png and *.jpg for documentation/screenshots, but ignore in outputs
music-eq-backend/outputs/**/*.png
music-eq-backend/outputs/**/*.jpg
music-eq-backend/outputs/**/*.jpeg

